{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        
        "Topics": [
          {
            "Name": "user-events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT20S",
              "RequiresDuplicateDetection": false
            },
            "Subscriptions": [
              {
                "Name": "subscriptions-module",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "reader-and-author-deleted",
                    "Properties": {
                      "FilterType": "Sql",
                      "SqlFilter": {
                        "SqlExpression": "sys.Label = 'ReaderDeleted' OR sys.Label = 'AuthorDeleted'"
                      }
                    }
                  },
                  {
                    "Name": "author-created",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": {
                        "Label": "AuthorCreated"
                      }
                    }
                  },
                  {
                    "Name": "reader-created",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": {
                        "Label": "ReaderCreated"
                      }
                    }
                  }
                ]
              },
              {
                "Name": "articles-module",
                "Properties": {
                  "DeadLetteringOnMessageExpiration": false,
                  "DefaultMessageTimeToLive": "PT1H",
                  "LockDuration": "PT1M",
                  "MaxDeliveryCount": 5,
                  "ForwardDeadLetteredMessagesTo": "",
                  "ForwardTo": "",
                  "RequiresSession": false
                },
                "Rules": [
                  {
                    "Name": "author-deleted",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": {
                        "Label": "AuthorDeleted"
                      }
                    }
                  },
                  {
                    "Name": "author-created",
                    "Properties": {
                      "FilterType": "Correlation",
                      "CorrelationFilter": {
                        "Label": "AuthorCreated"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}